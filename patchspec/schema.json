{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/claudeagent/patchspec.v1.schema.json",
  "title": "PatchSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "hunks",
    "anchors",
    "behaviors",
    "coverage",
    "generation"
  ],
  "properties": {
    "schema_version": {
      "enum": ["patchspec.v1"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cve_id", "project", "metadata_sha256"],
      "properties": {
        "cve_id": {"type": "string", "minLength": 1},
        "project": {"type": "string", "minLength": 1},
        "metadata_sha256": {"type": "string", "minLength": 64, "maxLength": 64}
      }
    },
    "hunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hunk_id", "ref", "header", "old_line_refs", "new_line_refs"],
        "properties": {
          "hunk_id": {"type": "string", "minLength": 1},
          "ref": {"type": "string", "minLength": 1},
          "header": {"type": "string"},
          "old_line_refs": {"type": "array", "items": {"type": "string"}},
          "new_line_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["anchor_id", "kind", "value", "role", "refs", "sides"],
        "properties": {
          "anchor_id": {"type": "string", "minLength": 1},
          "kind": {
            "enum": ["function", "callee", "string_literal", "character_constant", "integer_constant"]
          },
          "value": {"type": "string", "minLength": 1},
          "canonical_value": {"type": "string", "minLength": 1},
          "role": {"enum": ["localization"]},
          "refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "sides": {
            "type": "array",
            "minItems": 1,
            "items": {"enum": ["metadata", "old", "new"]}
          }
        }
      }
    },
    "behaviors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "behavior_id",
          "required",
          "hunk_ids",
          "function_anchor_ids",
          "trusted",
          "advisory"
        ],
        "properties": {
          "behavior_id": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "hunk_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "function_anchor_ids": {"type": "array", "items": {"type": "string"}},
          "trusted": {
            "type": "object",
            "additionalProperties": false,
            "required": ["old_indicators", "new_indicators"],
            "properties": {
              "old_indicators": {
                "type": "array",
                "items": {"$ref": "#/$defs/indicator"}
              },
              "new_indicators": {
                "type": "array",
                "items": {"$ref": "#/$defs/indicator"}
              }
            }
          },
          "advisory": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "security_invariant",
              "old_semantics",
              "new_semantics",
              "compiler_equivalent_forms",
              "applicability"
            ],
            "properties": {
              "security_invariant": {"type": "string", "minLength": 1},
              "old_semantics": {"type": "string", "minLength": 1},
              "new_semantics": {"type": "string", "minLength": 1},
              "compiler_equivalent_forms": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              },
              "applicability": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_hunk_ids", "covered_hunk_ids", "uncovered_hunk_ids"],
      "properties": {
        "all_hunk_ids": {"type": "array", "items": {"type": "string"}},
        "covered_hunk_ids": {"type": "array", "items": {"type": "string"}},
        "uncovered_hunk_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "model",
        "reasoning_effort",
        "prompt_version",
        "cache_key",
        "usage",
        "errors"
      ],
      "properties": {
        "mode": {"enum": ["generated", "repaired", "degraded", "deterministic_skeleton"]},
        "model": {"type": "string"},
        "reasoning_effort": {"type": "string"},
        "prompt_version": {"type": "string", "minLength": 1},
        "cache_key": {"type": "string", "minLength": 64, "maxLength": 64},
        "usage": {"type": "object"},
        "errors": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "ref"],
      "properties": {
        "kind": {"enum": ["source_line", "source_sequence"]},
        "value": {
          "type": ["string", "array"],
          "minLength": 1,
          "minItems": 1,
          "items": {"type": "string"}
        },
        "ref": {"type": "string", "minLength": 1}
      }
    }
  }
}
