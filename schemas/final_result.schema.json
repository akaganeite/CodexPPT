{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/claudeagent/final_result.schema.json",
  "title": "claudeagent final result",
  "$defs": {
    "submit_detection_result": {
      "type": "object",
      "properties": {
        "status": { "$ref": "#/properties/status" },
        "confidence": { "$ref": "#/properties/confidence" },
        "evidence_ids": { "$ref": "#/properties/evidence_ids" },
        "reasoning": { "$ref": "#/properties/reasoning" },
        "decisive_addresses": { "$ref": "#/properties/decisive_addresses" },
        "inconclusive_reason": { "$ref": "#/properties/inconclusive_reason" }
      },
      "required": [
        "status",
        "confidence",
        "evidence_ids",
        "reasoning",
        "decisive_addresses",
        "inconclusive_reason"
      ],
      "additionalProperties": false
    },
    "verification_claim_check": {
      "type": "object",
      "required": [
        "evidence_id",
        "relation",
        "decisive",
        "verifier_evidence_ids",
        "reason"
      ],
      "properties": {
        "evidence_id": { "type": "string", "pattern": "^ev_[0-9]{4,}$" },
        "relation": {
          "type": "string",
          "enum": ["supported", "contradicted", "insufficient"]
        },
        "decisive": { "type": "boolean" },
        "verifier_evidence_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^vev_[0-9]{4,}$" },
          "maxItems": 20
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1600 }
      },
      "additionalProperties": false
    },
    "verification_session": {
      "type": "object",
      "required": [
        "session_index",
        "outcome",
        "claim_budget",
        "claim_calls",
        "verdict_budget",
        "verdict_calls",
        "protocol_repairs",
        "failure_kind",
        "wall_seconds"
      ],
      "properties": {
        "session_index": { "type": "integer", "minimum": 1 },
        "outcome": {
          "type": "string",
          "enum": ["confirmed", "contradicted", "unresolved"]
        },
        "claim_budget": { "type": "integer", "minimum": 0, "maximum": 8 },
        "claim_calls": { "type": "integer", "minimum": 0, "maximum": 8 },
        "verdict_budget": { "type": "integer", "minimum": 0, "maximum": 5 },
        "verdict_calls": { "type": "integer", "minimum": 0, "maximum": 5 },
        "protocol_repairs": { "type": "integer", "minimum": 0, "maximum": 2 },
        "failure_kind": { "type": "string" },
        "wall_seconds": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "verification_repair": {
      "type": "object",
      "required": [
        "requested",
        "run_python_calls",
        "schema_repairs",
        "resubmitted",
        "reverified"
      ],
      "properties": {
        "requested": { "type": "boolean" },
        "run_python_calls": { "type": "integer", "minimum": 0, "maximum": 1 },
        "schema_repairs": { "type": "integer", "minimum": 0, "maximum": 1 },
        "resubmitted": { "type": "boolean" },
        "reverified": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "verification_usage_summary": {
      "type": "object",
      "required": ["provider", "model", "model_turns", "totals"],
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "model_turns": { "type": "integer", "minimum": 0 },
        "totals": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "verification_audit": {
      "type": "object",
      "required": [
        "mode",
        "protocol_version",
        "config_digest",
        "initial_status",
        "final_status",
        "recommended_status",
        "outcome",
        "claim_checks",
        "coverage_status",
        "coverage_reason",
        "verdict_evidence_ids",
        "reason",
        "sessions",
        "repair",
        "usage",
        "timing",
        "error"
      ],
      "properties": {
        "mode": { "type": "string", "enum": ["on", "off"] },
        "protocol_version": { "type": "string" },
        "config_digest": { "type": "string" },
        "initial_status": { "$ref": "#/properties/status" },
        "final_status": { "$ref": "#/properties/status" },
        "recommended_status": { "$ref": "#/properties/status" },
        "outcome": {
          "type": "string",
          "enum": ["off", "skipped", "confirmed", "contradicted", "unresolved"]
        },
        "claim_checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/verification_claim_check" },
          "maxItems": 8
        },
        "coverage_status": {
          "type": "string",
          "enum": ["not_run", "complete", "incomplete", "uncertain"]
        },
        "coverage_reason": { "type": "string", "maxLength": 1600 },
        "verdict_evidence_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^vev_[0-9]{4,}$" },
          "maxItems": 30
        },
        "reason": { "type": "string", "maxLength": 2400 },
        "sessions": {
          "type": "array",
          "items": { "$ref": "#/$defs/verification_session" },
          "maxItems": 2
        },
        "repair": { "$ref": "#/$defs/verification_repair" },
        "usage": { "$ref": "#/$defs/verification_usage_summary" },
        "timing": {
          "type": "object",
          "required": ["wall_seconds"],
          "properties": { "wall_seconds": { "type": "number", "minimum": 0 } },
          "additionalProperties": false
        },
        "error": { "type": "string", "maxLength": 4000 }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "ok",
    "project",
    "cve_id",
    "binary",
    "status",
    "confidence",
    "evidence",
    "evidence_ids",
    "reasoning",
    "decisive_addresses",
    "inconclusive_reason",
    "completed_at_epoch",
    "metadata_sha256",
    "observations",
    "evidence_ledger",
    "harness_metrics",
    "timing",
    "usage_metrics",
    "verification"
  ],
  "properties": {
    "schema_version": { "enum": ["final_result.v7"] },
    "ok": { "type": "boolean" },
    "project": { "type": "string" },
    "cve_id": { "type": "string" },
    "binary": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["present", "absent", "not_affected", "inconclusive"]
    },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "evidence": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 8
    },
    "evidence_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^ev_[0-9]{4,}$" },
      "maxItems": 8
    },
    "reasoning": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "decisive_addresses": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 30
    },
    "inconclusive_reason": {
      "type": "string",
      "enum": [
        "none",
        "insufficient_metadata",
        "no_binary_anchor",
        "stripped_or_optimized",
        "conflicting_evidence",
        "tool_failure",
        "unsupported_binary",
        "insufficient_tool_budget",
        "not_applicable_uncertain",
        "other"
      ]
    },
    "completed_at_epoch": { "type": "number" },
    "metadata_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "observation_id",
          "tool",
          "command",
          "command_text",
          "exit_code",
          "ok",
          "stdout_head",
          "stdout_tail",
          "stderr_tail",
          "truncated",
          "truncation",
          "parsed_facts"
        ],
        "properties": {
          "observation_id": { "type": "string", "pattern": "^obs_[0-9]{4,}$" },
          "tool": { "type": "string" },
          "command": { "type": "array", "items": { "type": "string" } },
          "command_text": { "type": "string" },
          "exit_code": { "type": ["integer", "null"] },
          "ok": { "type": "boolean" },
          "elapsed_sec": { "type": ["number", "null"] },
          "stdout_head": { "type": "string" },
          "stdout_tail": { "type": "string" },
          "stderr_tail": { "type": "string" },
          "truncated": { "type": "boolean" },
          "truncation": { "type": "object", "additionalProperties": true },
          "parsed_facts": { "type": "object", "additionalProperties": true },
          "error": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "evidence_ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "observation_id",
          "kind",
          "host_claim",
          "claim",
          "claim_source",
          "claim_status",
          "claim_revision",
          "created_response_index",
          "returned_response_index",
          "supporting_excerpt",
          "verification_excerpt",
          "verification_locators",
          "location",
          "confidence",
          "polarity"
        ],
        "properties": {
          "evidence_id": { "type": "string", "pattern": "^ev_[0-9]{4,}$" },
          "observation_id": { "type": "string", "pattern": "^obs_[0-9]{4,}$" },
          "kind": { "type": "string" },
          "host_claim": { "type": "string" },
          "claim": { "type": "string" },
          "claim_source": { "type": "string", "enum": ["host", "main_agent"] },
          "claim_status": { "type": "string", "enum": ["pending", "summarized"] },
          "claim_revision": { "type": "integer", "minimum": 0 },
          "created_response_index": { "type": "integer", "minimum": 0 },
          "returned_response_index": { "type": ["integer", "null"], "minimum": 0 },
          "claim_updated_response_index": { "type": "integer", "minimum": 1 },
          "supporting_excerpt": { "type": "array", "items": { "type": "string" } },
          "verification_excerpt": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "maxItems": 12
          },
          "verification_locators": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "properties": {
                "start": { "type": "string", "pattern": "^0x[0-9a-fA-F]+$" },
                "end": { "type": "string", "pattern": "^0x[0-9a-fA-F]+$" }
              },
              "required": ["start", "end"],
              "additionalProperties": false
            }
          },
          "location": { "type": "object", "additionalProperties": true },
          "confidence": { "type": "string" },
          "polarity": { "type": "string", "enum": ["positive", "negative"] }
        },
        "additionalProperties": true
      }
    },
    "harness_metrics": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "timing": {
      "type": "object",
      "required": ["wall_seconds"],
      "properties": { "wall_seconds": { "type": "number" } },
      "additionalProperties": true
    },
    "usage_metrics": {
      "type": "object",
      "required": ["provider", "model_turns", "totals", "by_turn", "timing"],
      "properties": {
        "provider": { "type": "string" },
        "model_turns": { "type": "integer", "minimum": 0 },
        "totals": { "type": "object", "additionalProperties": true },
        "by_turn": { "type": "array" },
        "timing": { "type": "object" }
      },
      "additionalProperties": true
    },
    "verification": { "$ref": "#/$defs/verification_audit" }
  }
}
